* {
	margin: 0;
	padding: 0;
	/*너비를 계산할때 패딩값과 너비를 같이 계산한다*/
	box-sizing: border-box;
	font-size: 16px;
}

body {
	/* 브라우저 기본 폰트를 이용해서 배수로 단위 rem*/
	margin: 1rem;
	background-color: black;
	color: white;
}

a {
	/*부모에 있는 글자 색상을 그대로 물려받아라!*/
	color: inherit;
	text-decoration: none;
}

header {
	display: flex;
	justify-content: space-between;
}

main {
	text-align: center;
}

main h1 {
	font-size: 3.5rem; /*16px * 2 = 32px
     16px * 3 = 48px
     16px * 3.5 = 56px*/
}

main h3 {
	font-size: 1.8rem;
	color: #86868b;
}

/*가운에 화면 정렬!
CSS 우선순위!
태크명이랑 클래스명이랑 클래스명이 우선적으로 적용된다.

*/
.max-container {
	width: 1200px;
	margin: 1rem auto;
}

.btns {
	padding: 1rem;
}

.main-image img {
	width: 80%;
	border-radius: 1.5rem;
}